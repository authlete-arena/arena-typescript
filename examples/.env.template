# @authlete/arena SDK Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Security Configuration
# The SDK supports loading security credentials from environment variables
# with the prefix: ARENA_
#
# Security environment variables:
ARENA_BEARER=your_bearer_here
ARENA_DPOP=your_dpop_here

# Debug Configuration
# Enable HTTP request/response logging for debugging
ARENA_DEBUG=true
